{
  "name": "dango-providers",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sha": "node sha.mjs",
    "sha:write": "node sha.mjs --write",
    "release": "node release.mjs",
    "test": "node --test scripts.test.mjs",
    "check:release": "node check-release.mjs",
    "check:host": "node --import ../dango/server/node_modules/tsx/dist/loader.mjs check-host.mjs ../dango",
    "check": "npm run lint && npm run format:check && npm run sha && npm run check:release && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "got-scraping": "^4.2.2",
    "prettier": "^3.8.3"
  }
}
